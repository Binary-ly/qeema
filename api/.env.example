# SPDX-License-Identifier: Apache-2.0
#
# Copy to .env for host-based development. When running under docker compose all
# of these are supplied by the compose file — you do not need a .env at all.
#
# There is deliberately no API key of any kind in this file. Qeema depends on no
# paid or proprietary service (constraint C1); if a change to this project ever
# adds a required secret for a third-party service, that change is wrong.

APP_NAME=Qeema
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- database ---------------------------------------------------------------
# PostgreSQL with pgvector and pg_trgm is required; SQLite cannot host either.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qeema
DB_USERNAME=qeema
DB_PASSWORD=qeema

# --- cache, queue, session --------------------------------------------------
# Redis 8+ (AGPLv3 option) or a wire-compatible BSD alternative such as Valkey.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- ML service -------------------------------------------------------------
# Reached only over HTTP. The app never imports an ML library.
QEEMA_ML_URL=http://127.0.0.1:8000
QEEMA_ML_TIMEOUT=10
QEEMA_ML_CONNECT_TIMEOUT=2
QEEMA_ML_RETRIES=2
# Circuit breaker: after this many consecutive failures the app stops calling
# the ML service and degrades gracefully rather than failing requests.
QEEMA_ML_CB_FAILURES=5
QEEMA_ML_CB_COOLDOWN=60

# --- platform ---------------------------------------------------------------
QEEMA_VERSION=0.1.0
# The only place country facts live. Everything else reads them from the DB.
QEEMA_COUNTRIES_PATH=../countries
# Comma-separated ISO-3166-1 alpha-2 codes, or * for every config present.
QEEMA_SEED_COUNTRIES=*

# Synthetic demo history, so a fresh deployment is demonstrable immediately.
QEEMA_SEED_DEMO=true
QEEMA_SEED_DEMO_MONTHS=6
# Fixed seed keeps the demo reproducible across machines.
QEEMA_SEED_RANDOM_SEED=20260101

# --- public API -------------------------------------------------------------
# Read routes are unauthenticated by design; rate limiting is the only guard.
QEEMA_API_RATE_LIMIT=120
QEEMA_API_MAX_PAGE_SIZE=500

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
