# SPDX-License-Identifier: Apache-2.0
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - app
        - database
        - routes

    ignoreErrors:
        # Larastan types Seeder::$command as non-nullable, but it is genuinely
        # null when a seeder is constructed and run programmatically rather than
        # through `artisan db:seed`. The nullsafe calls are load-bearing.
        -
            identifier: nullsafe.neverNull
            path: database/seeders/*.php
